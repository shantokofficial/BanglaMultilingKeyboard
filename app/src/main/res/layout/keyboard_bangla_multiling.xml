<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/multilingBanglaRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#FF090909"
    android:orientation="vertical"
    android:paddingStart="2dp"
    android:paddingTop="4dp"
    android:paddingEnd="2dp"
    android:paddingBottom="4dp">

    <!-- Compact suggestion / punctuation strip, as in the reference keyboard -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:orientation="horizontal"
        android:weightSum="6">
        <Button style="@style/MlBanglaActionKey" android:text="।" />
        <Button style="@style/MlBanglaActionKey" android:text="?" />
        <Button style="@style/MlBanglaActionKey" android:text="," />
        <Button style="@style/MlBanglaActionKey" android:text="&quot;" />
        <Button style="@style/MlBanglaActionKey" android:text="'" />
        <Button style="@style/MlBanglaActionKey" android:text=":" />
    </LinearLayout>

    <!-- Row 1: original Bengali key order from the supplied reference -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginBottom="2dp"
        android:orientation="horizontal">
        <Button style="@style/MlBanglaKey" android:text="ৌ" />
        <Button style="@style/MlBanglaKey" android:text="ৈ" />
        <Button style="@style/MlBanglaKey" android:text="া" />
        <Button style="@style/MlBanglaKey" android:text="ী" />
        <Button style="@style/MlBanglaKey" android:text="ূ" />
        <Button style="@style/MlBanglaKey" android:text="ব" />
        <Button style="@style/MlBanglaKey" android:text="হ" />
        <Button style="@style/MlBanglaKey" android:text="গ" />
        <Button style="@style/MlBanglaKey" android:text="দ" />
        <Button style="@style/MlBanglaKey" android:text="জ" />
        <Button style="@style/MlBanglaKey" android:text="ড" />
        <Button style="@style/MlBanglaKey" android:text="-" />
    </LinearLayout>

    <!-- Row 2 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginBottom="2dp"
        android:orientation="horizontal">
        <Button style="@style/MlBanglaKey" android:text="ো" />
        <Button style="@style/MlBanglaKey" android:text="ে" />
        <Button style="@style/MlBanglaKey" android:text="ি" />
        <Button style="@style/MlBanglaKey" android:text="ু" />
        <Button style="@style/MlBanglaKey" android:text="প" />
        <Button style="@style/MlBanglaKey" android:text="ৰ" />
        <Button style="@style/MlBanglaKey" android:text="ক" />
        <Button style="@style/MlBanglaKey" android:text="ত" />
        <Button style="@style/MlBanglaKey" android:text="চ" />
        <Button style="@style/MlBanglaKey" android:text="ট" />
        <Button style="@style/MlBanglaKey" android:text="ং" />
        <Button style="@style/MlBanglaKey" android:text="ঃ" />
    </LinearLayout>

    <!-- Row 3 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginBottom="2dp"
        android:orientation="horizontal">
        <Button
            android:id="@+id/btnMlShift"
            style="@style/MlBanglaActionKey"
            android:layout_weight="1.25"
            android:text="⇧" />
        <Button style="@style/MlBanglaKey" android:text="ং" />
        <Button style="@style/MlBanglaKey" android:text="ম" />
        <Button style="@style/MlBanglaKey" android:text="ন" />
        <Button style="@style/MlBanglaKey" android:text="ৱ" />
        <Button style="@style/MlBanglaKey" android:text="ল" />
        <Button style="@style/MlBanglaKey" android:text="স" />
        <Button style="@style/MlBanglaKey" android:text="য" />
        <Button style="@style/MlBanglaKey" android:text="়" />
        <Button
            android:id="@+id/btnMlDelete"
            style="@style/MlBanglaActionKey"
            android:layout_weight="1.25"
            android:text="⌫" />
    </LinearLayout>

    <!-- Bottom controls -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:orientation="horizontal">
        <Button
            android:id="@+id/btnMlSymbol"
            style="@style/MlBanglaActionKey"
            android:layout_weight="1.35"
            android:text="&#63;123" />
        <Button
            android:id="@+id/btnMlEmoji"
            style="@style/MlBanglaActionKey"
            android:layout_weight="1.0"
            android:text="😀" />
        <Button
            android:id="@+id/btnMlSpace"
            style="@style/MlBanglaSpaceKey"
            android:layout_weight="3.8"
            android:text="◀ বাংলা ▶" />
        <Button
            android:id="@+id/btnMlDot"
            style="@style/MlBanglaActionKey"
            android:layout_weight="0.8"
            android:text="." />
        <Button
            android:id="@+id/btnMlReturn"
            style="@style/MlBanglaActionKey"
            android:layout_weight="1.4"
            android:text="↵" />
    </LinearLayout>
</LinearLayout>